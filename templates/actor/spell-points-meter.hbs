{{#if system.spheres}}
{{#with system.spheres.spellPoints}}
<div class="meter-group custom-spell-points">
    <div class="label roboto-condensed-upper">
        <span>Spell Points</span>
    </div>
    <div class="meter sectioned hit-points">
        <div class="progress hit-points"
             role="meter" aria-valuemin="0" aria-valuenow="{{ value }}"
             aria-valuemax="{{ max }}" style="--bar-percentage: calc(100 * {{ value }} / max(1, {{ max }}))%">
            
            <div class="label sp-text" style="cursor: pointer;">
                <span class="value">{{ value }}</span>
                <span class="separator">&sol;</span>
                <span class="max">{{ max }}</span>
            </div>
            {{#if @root.editable}}
            <input type="number" class="sp-input" name="flags.spheres-of-power.spellPointsValue" data-dtype="Number"
                   placeholder="0" value="{{ value }}" style="display: none; width: 100%; text-align: center; background: transparent; border: none; color: inherit; font-weight: bold; outline: none;">
            {{/if}}
        </div>
    </div>
</div>
{{/with}}
{{/if}}